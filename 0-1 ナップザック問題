#include <iostream>
#include <algorithm>
#include <vector>
using namespace std;

struct thing{
    int value;
    int weight;
};

int main(void){
    int n, w;
    cin >> n;
    cin >> w;
    vector<thing> m(n+1);
    for(int i=1; i<=n; i++){
        cin >> m[i].value;
        cin >> m[i].weight;
    }
    
    vector<vector<int>> a(n+1, vector<int>(w+1));
    
    for(int i=0; i<=n; i++){
        a[i][0] = 0;
    }
    
    for(int i=0; i<n; i++){
        for(int j=0; j<= w; j++){
            if(j - m[i + 1].weight >= 0) a[i+1][j] = max(a[i][j], a[i][j - m[i + 1].weight] + m[i + 1].value);
            else a[i+1][j] = a[i][j];
        }
    }
    cout << a[n][w] << '\n';
    return 0;
}
