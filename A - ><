#include <iostream>
#include <algorithm>
#include <vector>
#include <queue>
using namespace std;

int main(void){
  char t;
  int n = 0;
  long long SUM=0;
  vector<char> s;
  
  for(int i=0; cin >> t; i++){
    n++;
    s.push_back(t);
  }
  vector<int> left(n+1, 0);
  vector<int> right(n+1, 0);
  
  for(int i=1; i<=n; i++){
    int id = i - 1;
    int j = n - i;
    if(s[id] == '<'){
      left[i] = left[i - 1] + 1;
    }
    if(s[n - 1 - id] == '>'){
      right[j] = right[j + 1] + 1;
    }
  }
  
  for(int i=0; i<=n; i++){
    SUM += max(left[i], right[i]);
  }
  cout << SUM << '\n';
  return 0;
}
