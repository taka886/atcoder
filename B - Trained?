#include <iostream>
#include <algorithm>
#include <vector>
using namespace std;

struct booton{
  int number;
  int turnon;
};

int main(void){
  int n, num=0, id=1;
  cin >> n;
  vector<booton> a(n+1, {0, 0});
  for(int i=1; i<=n; i++) cin >> a[i].number;
  a[1].turnon = 1;
  for(int i=1; i<=n; i++){
    id = a[id].number;
    num++;
    if(id == 2){
      cout << num << '\n';
      return 0;
    }
    a[id].turnon++;
    if(a[id].turnon > 1){
      cout << -1 << '\n';
      return 0;
    }
  }
  return 0;
}
