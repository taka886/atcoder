#include <iostream>
#include <algorithm>
#include <vector>
using namespace std;

int get_numid(long long num){
  int Sum=0;
  while(num % 2 == 0){
    num /= 2;
    Sum++;
  }
  return Sum;
}

int main(void){
  int n, Sum = 0;
  long long t;
  cin >> n;
  for(int i=0; i<n; i++){
    cin >> t;
    Sum += get_numid(t);
  }
  cout << Sum << '\n';
  return 0;
}
