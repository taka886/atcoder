#include <iostream>
#include <algorithm>
#include <vector>
using namespace std;
const long long infty = 100000000000000;

long long absl(long long a){
  if(a < 0) return -1 * a;
  else return a;
}

int main(void){
  long long n, Min = infty, min_id, dist, right, left;
  cin >> n;
  vector<long long> m(n + 1, infty);
  for(long long i=0; i<n; i++){
    cin >> m[i];
    if(absl(m[i]) == absl(Min)){
      Min = min(Min, m[i]);
      continue;
    }
    if(absl(m[i]) < absl(Min)){
      Min = m[i];
    }
  }
  sort(m.begin(), m.end());
  for(long long i=0; i<n; i++){
    if(m[i] == Min){
      min_id = i;
      break;
    }
  }
  long long cur = min_id;
  left = cur - 1;
  right = cur + 1;
  dist = absl(Min);
  for(long long i=0; i<n - 1; i++){
    long long t = cur;
    if(left < 0 || m[cur] - m[left] > m[right] - m[cur]){
      dist += m[right] - m[cur];
      cur = right;
      right++;
    }
    else if(m[cur] - m[left] <= m[right] - m[cur]){
      dist += m[cur] - m[left];
      cur = left;
      left--;
    }
    m[t] = infty;
  }
  cout << dist << '\n';
  return 0;
}
