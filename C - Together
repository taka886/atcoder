#include <iostream>
#include <algorithm>
#include <vector>
using namespace std;


int main(void){
  int n, a, maxid = 0;
  vector<bool> m(100001, false);
  vector<int> num(100001, 0);
  cin >> n;
  for(int i=0; i<n; i++){
    cin >> a;
    if(a != 0){
      m[a] = true;
      num[a - 1]++;
      num[a + 1]++;
      num[a]++;
      maxid = (num[maxid] >= num[a - 1] ? maxid : a - 1);
      maxid = (num[maxid] >= num[a + 1] ? maxid : a + 1);
      maxid = (num[maxid] >= num[a] ? maxid : a);
    }
    else{
      m[a] = true;
      num[a + 1]++;
      num[a]++;
      maxid = (num[maxid] >= num[a + 1] ? maxid : a + 1);
      maxid = (num[maxid] >= num[a] ? maxid : a);
    }
  }
  cout << num[maxid] << '\n';
  return 0;
}
