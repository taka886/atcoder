#include <iostream>
#include <algorithm>
#include <vector>
using namespace std;

int main(void){
  long long n;
  cin >> n;
  vector<long long> a(n+1);
  vector<long long> num(n+1, 0);
  long long s = 0;
  for(int i=1; i<=n; i++){
    cin >> a[i];
    num[a[i]]++;
  }
  for(int i=1; i<=n; i++){
    s += (num[i] * (num[i] - 1)) / 2;
  }
  for(int i=1; i<=n; i++){
    cout << s - ( (num[a[i]] * (num[a[i]] - 1)) / 2 - ((num[a[i]] - 1) * (num[a[i]] - 2)) / 2) << '\n';
  }
  return 0;
}
