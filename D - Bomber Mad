#include <iostream>
#include <algorithm>
#include <vector>
#include <string>
#include <queue>
using namespace std;
#define rep(i, n) for(long long i=0; i<(long long)(n); i++)
long long total=0, h, w, k;
vector<string> m;
struct z{
  long long y;
  long long x;
  long long t;
};

void bfs(queue<z> Q, vector<vector<char>> &cr){
  vector<int> x_d(4);
  x_d[0] = -1;
  x_d[1] = 0;
  x_d[2] = 1;
  x_d[3] = 0;
  vector<int> y_d(4);
  y_d[0] = 0;
  y_d[1] = 1;
  y_d[2] = 0;
  y_d[3] = -1;
  z cur;
  while(!Q.empty() && Q.front().t < k){
    cur.x = Q.front().x;
    cur.y = Q.front().y;
    cur.t = Q.front().t;
    Q.pop();
    cr[cur.y][cur.x] = 'B';
    rep(i, 4){
      z ne;
      ne.x = cur.x + x_d[i];
      ne.y = cur.y + y_d[i];
      ne.t = cur.t + 1;
      if(ne.x >= 0 && ne.x <= w - 1 && ne.y >= 0 && ne.y <= h - 1 && m[ne.y][ne.x] != '#' && cr[ne.y][ne.x] == 'h'){
        Q.push(ne);
        cr[ne.y][ne.x] = 'G';
        total++;
      }
    }
  }
  return;
}

int main(void){
  cin >> h >> w >> k;
  m.resize(h);
  vector<bool> col_c(w, false);
  vector<bool> row_c(h, false);
  vector<vector<char>> cr(h, vector<char>(w, 'h'));
  rep(i, h){
    cin >> m[i];
    rep(j, w){
      if(m[i][j] == '#'){
        col_c[j] = true;
        row_c[i] = true;
      }
    }
  }
  rep(i, h){
    rep(j, w){
      if(m[i][j] != '#' && row_c[i] == false && col_c[j] == false){
        m[i][j] = 's';
      }
    }
  }
  queue<z> Q;
  rep(i, h){
    rep(j, w){
      if(m[i][j] == 's'){
        cr[i][j] = 'G';
        total++;
        Q.push({i, j, 0});
      }
    }
  }
  bfs(Q, cr);
  cout << total << '\n';
  return 0;
}
