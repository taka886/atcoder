#include <iostream>
#include <algorithm>
#include <queue>
using namespace std;

int main(void){
  
  priority_queue<long long> min_pq;
  priority_queue<long long, vector<long long>, greater<long long>> max_pq;
  long long x, a, b;
  long long n;
  cin >> x;
  cin >> n;
  min_pq.push(x);
  long long m;
  m = x;
  for(int i=0; i<n; i++){
    cin >> a;
    cin >> b;
    if(m >= a&&m >= b){
      long long t;
      t = min_pq.top();
      min_pq.pop();
      max_pq.push(t);
      min_pq.push(a);
      min_pq.push(b);
      m = min_pq.top();
      cout << m << '\n';
    }
    else if(m < a&&m < b){
      if(a >= b){
        max_pq.push(a);
        if(max_pq.top() >= b) min_pq.push(b);
        else{
          min_pq.push(max_pq.top());
          max_pq.pop();
          max_pq.push(b);
        }
        m = min_pq.top();
        cout << m << '\n';
      }
      else{
        max_pq.push(b);
        if(max_pq.top() >= a) min_pq.push(a);
        else{
          min_pq.push(max_pq.top());
          max_pq.pop();
          max_pq.push(a);
        }
        m = min_pq.top();
        cout << m << '\n';
      }
    }
    else if(m <= a && m >= b){
      max_pq.push(a);
      min_pq.push(b);
      m = min_pq.top();
      cout << m << '\n';
    }
    else{
      max_pq.push(b);
      min_pq.push(a);
      m = min_pq.top();
      cout << m << '\n';
    }
  }
  return 0;
}
