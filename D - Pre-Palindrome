#include <iostream>
#include <algorithm>
#include <vector>
using namespace std;

int cnt_odd(string &s, int id){
  int total = 1, ng = 0, right, left;
  right = id + 1;
  left = id - 1;
  for(int i=1; left >= 0 && right < s.size(); i++){
    if(s[left] != s[right]){
      if(ng >= 1) break;
      ng++;
    }
    total++;
    left--;
    right++;
  }
  return total;
}

int cnt_ev(string &s, int id){
  int total = 0, ng = 0, right, left;
  right = id;
  left = id - 1;
  for(int i = 0; left >= 0 && right < s.size(); i++){
    if(s[left] != s[right]){
      if(ng >= 1) break;
      ng++;
    }
    total++;
    left--;
    right++;
  }
  return total;
}

int main(void){
  string s;
  long long t = 0;
  cin >> s;
  if(s.size() == 1){
    cout << 1 << '\n';
    return 0;
  }
  for(int i=1; i<s.size() - 1; i++){
    t += cnt_odd(s, i);
  }
  t += 2;
  for(int i=1; i<s.size(); i++){
    t += cnt_ev(s, i);
  }
  cout << t << '\n';
  return 0;
}
