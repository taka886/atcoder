#include <iostream>
#include <algorithm>
#include <vector>
#include <queue>
using namespace std;
const int infty = 1000010;

struct coordinate{
  int x;
  int y;
};

bool in(int y, int x, int h, int w){
  return ((0 <= y && y < h)&&(0 <= x && x < w));
}

void solve(vector<string> &m, int h, int w){
    vector<vector<int>> d(h, vector<int>(w, infty));
    vector<string> border(h, string(w, '.'));
    vector<int> dx = {1, -1, 0, 0, 1, -1, 1, -1};
    vector<int> dy = {0, 0, 1, -1, -1, -1, 1, 1};
    queue<coordinate> q;
    
    for(int i=0; i<h; i++){
      for(int j=0; j<w; j++){
        if(m[i][j] == '.'){
          for(int u=0; u<8; u++){
            if(in(i + dy[u], j + dx[u], h, w) && m[i + dy[u]][j + dx[u]] == '#'){
              border[i][j] = '#';
              q.push({j, i});
              d[i][j] = 0;
              break;
            } // あえて1ターンバッファを設けることで境界のみを黒で抽出
          }
        }
      }
    }

    while(!q.empty()){
      coordinate cur;
      cur = q.front();
      q.pop();
      for(int i=0; i<8; i++){
        if(in(cur.y + dy[i], cur.x + dx[i], h, w) && d[cur.y + dy[i]][cur.x + dx[i]] == infty){
          q.push({cur.x + dx[i], cur.y + dy[i]});
          d[cur.y + dy[i]][cur.x + dx[i]] = d[cur.y][cur.x] + 1;
        }
      }
    }
    
    for(int i=0; i<h; i++){
      for(int j=0; j<w; j++){
        if(d[i][j] % 2 == 0){ // 偶数であれば、1回目の境界と同相、奇数であればその逆
          cout << '.' << (j == w - 1 ? "\n" : "");
        }
        else{
          cout << '#' << (j == w - 1 ? "\n" : "");
        }
      }
    }
  return;
}

int main(void){
  int h, w;
  cin >> h;
  cin >> w;
  vector<string> m(h, string(w, '.'));
  for(int i=0; i<h; i++){
    for(int j=0; j<w; j++){
      cin >> m[i][j];
    }
  }
  solve(m, h, w);
  return 0;
}
